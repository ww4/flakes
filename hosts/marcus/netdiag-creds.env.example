# netdiag camera credentials — copy to ~/.config/netdiag/camera-creds.env (chmod 600)
#
# Read from a FILE, never passed on the command line: an RTSP URL in argv is
# visible in `ps` and in shell history, and ffprobe echoes it back in its JSON
# `format.filename` field. Note also that cameras often keep a SEPARATE ONVIF
# user list from the web-UI user list — a working web login can still be an
# unauthorised ONVIF/RTSP user.
CAM_USER=admin
CAM_PASS=
