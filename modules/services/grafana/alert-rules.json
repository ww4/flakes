expression":"A","intervalMs":1000,"maxDataPoints":43200,"refId":"C","type":"threshold"}}],"noDataState":"OK","execErrState":"OK","for":"10m","annotations":{"description":"HDD {{ $labels.device }} ({{ $labels.model }}, {{ $labels.bus }}) is running warm ({{ $values.A.Value }} \u00b0C, limit 50). Check pool/enclosure airflow \u2014 see the Temperatures dashboard.","summary":"{{ $labels.device }} {{ $labels.model }} \u2014 {{ $values.A.Value }} \u00b0C"},"labels":{"component":"thermal","severity":"warning"},"isPaused":false}]},{"orgId":1,"name":"storage","folder":"Alerts","interval":"1m","rules":[{"uid":"stnpoolmemoffl1","title":"PoolMemberOffline","condition":"C","data":[{"refId":"A","relativeTimeRange":{"from":600,"to":0},"datasourceUid":"PBFA97CFB590B2093","model":{"expr":"count(node_filesystem_size_bytes{mountpoint=~\"/mnt/primary/D[1-6]\"})","instant":true,"intervalMs":1000,"maxDataPoints":43200,"range":false,"refId":"A"}},{"refId":"C","relativeTimeRange":{"from":0,"to":0},"datasourceUid":"__expr__","model":{"conditions":[{"evaluator":{"params":[6],"type":"lt"},"operator":{"type":"and"},"query":{"params":["C"]},"reducer":{"type":"last"},"type":"query"}],"expression":"A","intervalMs":1000,"maxDataPoints":43200,"refId":"C","type":"threshold"}}],"noDataState":"OK","execErrState":"OK","for":"5m","annotations":{"description":"Fewer than 6 /mnt/fusion pool members are mounted \u2014 a drive (likely a USB external) has dropped off the bus. Remediation: df -h /mnt/primary/D* ; sudo mount the missing member ; recreate its .pool-member sentinel ; run 'media-mirror preflight'.","summary":"A /mnt/fusion pool member is offline (fusion degraded)"},"labels":{"component":"storage","severity":"warning"},"isPaused":false},{"uid":"stnbkppoolmemof1","title":"BackupPoolMemberOffline","condition":"C","data":[{"refId":"A","relativeTimeRange":{"from":600,"to":0},"datasourceUid":"PBFA97CFB590B2093","model":{"expr":"count(node_filesystem_size_bytes{mountpoint=~\"/mnt/backup/D[1-4]\"})","instant":true,"intervalMs":1000,"maxDataPoints":43200,"range":false,"refId":"A"}},{"refId":"C","relativeTimeRange":{"from":0,"to":0},"datasourceUid":"__expr__","model":{"conditions":[{"evaluator":{"params":[4],"type":"lt"},"operator":{"type":"and"},"query":{"params":["C"]},"reducer":{"type":"last"},"type":"query"}],"expression":"A","intervalMs":1000,"maxDataPoints":43200,"refId":"C","type":"threshold"}}],"noDataState":"OK","execErrState":"OK","for":"5m","annotations":{"description":"Fewer than 4 /mnt/backup/all pool members are mounted \u2014 a backup drive has dropped off the bus or failed to mount after a hot-plug. IMPORTANT: while a branch is missing, mergerfs falls back to the bare /mnt/backup/D* directory on the ROOT SSD, so /mnt/backup/all will report ~449G instead of 22T and any write lands on the nvme. The restic/media-mirror/bub preflights refuse to run in this state, so backups are STOPPED until it is fixed. Remediation: df -h /mnt/backup/D* ; sudo systemctl start mnt-backup-D<n>.mount ; confirm 'df -h /mnt/backup/all' reads 22T. pool-autoremount retries every 2 min up to 3x/24h.","summary":"A /mnt/backup/all pool member is offline \u2014 BACKUPS ARE STOPPED"},"labels":{"component":"storage","severity":"warning"},"isPaused":false},{"uid":"stnpoolmemunhl1","title":"PoolMemberUnhealthy","condition":"C","data":[{"refId":"A","relativeTimeRange":{"from":600,"to":0},"datasourceUid":"PBFA97CFB590B2093","model":{"expr":"min(pool_member_healthy)","instant":true,"intervalMs":1000,"maxDataPoints":43200,"range":false,"refId":"A"}},{"refId":"C","relativeTimeRange":{"from":0,"to":0},"datasourceUid":"__expr__","model":{"conditions":[{"evaluator":{"params":[1],"type":"lt"},"operator":{"type":"and"},"query":{"params":["C"]},"reducer":{"type":"last"},"type":"query"}],"expression":"A","intervalMs":1000,"maxDataPoints":43200,"refId":"C","type":"threshold"}}],"noDataState":"NoData","execErrState":"Error","for":"10m","annotations":{"description":"A storage pool member is mounted but not answering real I/O, or is missing entirely. Unlike PoolMemberOffline \u2014 which counts mount entries and therefore CANNOT see a zombie mount, as on 2026-08-17 \u2014 this is derived from an actual readdir performed by pool-autoremount. Remediation: journalctl -u pool-autoremount ; the reconciler clears zombies itself, so a sustained firing means it could not.","summary":"A storage pool member is unhealthy (mounted but erroring, or missing)"},"labels":{"component":"storage","severity":"warning"},"isPaused":false},{"uid":"stnqbithnrnosd1","title":"QbitHnRNotSeeding","condition":"C","data":[{"refId":"A","relativeTimeRange":{"from":600,"to":0},"datasourceUid":"PBFA97CFB590B2093","model":{"expr":"max(qbit_hnr_not_seeding)","instant":true,"intervalMs":1000,"maxDataPoints":43200,"range":false,"refId":"A"}},{"refId":"C","relativeTimeRange":{"from":0,"to":0},"datasourceUid":"__expr__","model":{"conditions":[{"evaluator":{"params":[0],"type":"gt"},"operator":{"type":"and"},"query":{"params":["C"]},"reducer":{"type":"last"},"type":"query"}],"expression":"A","intervalMs":1000,"maxDataPoints":43200,"refId":"C","type":"threshold"}}],"noDataState":"NoData","execErrState":"Error","for":"30m","annotations":{"description":"One or more torrents on a private tracker still owe seed time AND are not currently seeding, so a hit-and-run clock is running. This is the alert that was missing on 2026-08-17, when 26 private-tracker torrents sat in missingFiles for 19 h and the first notice was an email from DarkPeers. Remediation: journalctl -u qbit-seed-guard ; it force-rechecks recoverable torrents itself, so a sustained firing means it could not (data genuinely absent, attempt cap hit, or the pool is degraded).","summary":"A private-tracker torrent with an unmet H&R requirement has stopped seeding"},"labels":{"component":"seeding","severity":"warning"},"isPaused":false},{"uid":"stnqbitmissfil1","title":"QbitTorrentsMissingFiles","condition":"C","data":[{"refId":"A","relativeTimeRange":{"from":600,"to":0},"datasourceUid":"PBFA97CFB590B2093","model":{"expr":"qbit_torrents_missing_files","instant":true,"intervalMs":1000,"maxDataPoints":43200,"range":false,"refId":"A"}},{"refId":"C","relativeTimeRange":{"from":0,"to":0},"datasourceUid":"__expr__","model":{"conditions":[{"evaluator":{"params":[0],"type":"gt"},"operator":{"type":"and"},"query":{"params":["C"]},"reducer":{"type":"last"},"type":"query"}],"expression":"A","intervalMs":1000,"maxDataPoints":43200,"refId":"C","type":"threshold"}}],"noDataState":"NoData","execErrState":"Error","for":"1h","annotations":{"description":"qBittorrent dropped torrents to missingFiles and they have not recovered within the hour. qBit NEVER retries a rejected fast-resume, so these stay dead until force-rechecked. Usually caused by a qBit restart landing while a storage-pool member was missing. qbit-seed-guard recovers these automatically when the data is present and the pool is healthy.","summary":"qBittorrent has torrents stuck in missingFiles"},"labels":{"component":"seeding","severity":"warning"},"isPaused":false},{"uid":"stnqbithnrbrch1","title":"QbitHnRBreached","condition":"C","data":[{"refId":"A","relativeTimeRange":{"from":600,"to":0},"datasourceUid":"PBFA97CFB590B2093","model":{"expr":"max(qbit_hnr_breached)","instant":true,"intervalMs":1000,"maxDataPoints":43200,"range":false,"refId":"A"}},{"refId":"C","relativeTimeRange":{"from":0,"to":0},"datasourceUid":"__expr__","model":{"conditions":[{"evaluator":{"params":[0],"type":"gt"},"operator":{"type":"and"},"query":{"params":["C"]},"reducer":{"type":"last"},"type":"query"}],"expression":"A","intervalMs":1000,"maxDataPoints":43200,"refId":"C","type":"threshold"}}],"noDataState":"NoData","execErrState":"Error","for":"10m","annotations":{"description":"A torrent's hit-and-run deadline (e.g. RetroToon's 72 h within 10 days of download) elapsed without the seed requirement being met. This is not self-correcting \u2014 the credit window has closed. Check which torrent via: qbit-seed-guard (journal) and the tracker's own H&R page.","summary":"A tracker H&R deadline passed with the requirement unmet"},"labels":{"component":"seeding","severity":"warning"},"isPaused":false},{"uid":"stnqbitguardst1","title":"QbitSeedGuardStale","condition":"C","data":[{"refId":"A","relativeTimeRange":{"from":600,"to":0},"datasourceUid":"PBFA97CFB590B2093","model":{"expr":"time() - qbit_seed_guard_last_success_epoch","instant":true,"intervalMs":1000,"maxDataPoints":43200,"range":false,"refId":"A"}},{"refId":"C","relativeTimeRange":{"from":0,"to":0},"datasourceUid":"__expr__","model":{"conditions":[{"evaluator":{"params":[1800],"type":"gt"},"operator":{"type":"and"},"query":{"params":["C"]},"reducer":{"type":"last"},"type":"query"}],"expression":"A","intervalMs":1000,"maxDataPoints":43200,"refId":"C","type":"threshold"}}],"noDataState":"NoData","execErrState":"Error","for":"15m","annotations":{"description":"The seeding watchdog itself has not published a successful run in over 30 min (it runs every 5 min), so the H&R metrics are stale and nothing is watching the trackers. Check: systemctl status qbit-seed-guard ; journalctl -u qbit-seed-guard. Note it deliberately skips publishing when the qBittorrent API is unreachable, so this also fires when qBit is down.","summary":"qbit-seed-guard has not completed a run recently"},"labels":{"component":"seeding","severity":"warning"},"isPaused":false}]}]}
